# AnySlide environment template
#
# Copy this file to .env.local for local development.
# Values without NEXT_PUBLIC_ must stay server-side only.
# Do not commit real credentials.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Database
DATABASE_URL=

# Storage
# Use local for development. Use r2 or another S3-compatible adapter in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./tmp
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Text generation
# The app reads ANYSLIDE_TEXT_* for Anthropic-compatible text APIs.
ANYSLIDE_TEXT_API_KEY=
ANYSLIDE_TEXT_BASE_URL=
ANYSLIDE_TEXT_MODEL_DEFAULT=
ANYSLIDE_TEXT_MODEL_HIGH=
ANYSLIDE_TEXT_MODEL_LOW=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Image generation
# OPENAI_BASE_URL may point to OpenAI or an OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Research and media search
JINA_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ANYSLIDE_BRAND_NAME=AnySlide

# Stripe billing
# Leave these empty if you do not run paid billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TOPUP_5=
STRIPE_PRICE_TOPUP_20=
STRIPE_PRICE_TOPUP_50=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_ENABLE_ALIPAY=false
STRIPE_ENABLE_WECHAT_PAY=false

# Inngest
# Keep INNGEST_DEV=1 for local development with the Inngest dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA_ID=
